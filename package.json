{
	"name": "@bedrock-core/apps",
	"version": "0.0.0",
	"private": true,
	"description": "Applications built on the bedrock-core stack",
	"keywords": [
		"minecraft",
		"bedrock",
		"cross-addon",
		"ui",
		"framework"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": "github:bedrock-core/apps",
	"type": "module",
	"sideEffects": false,
	"packageManager": "yarn@4.16.0",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "yarn workspaces foreach -ptA run build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "yarn workspaces foreach -ptA run lint",
		"test": "yarn workspaces foreach -ptA run test",
		"coverage": "yarn workspaces foreach -ptA run coverage",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "yarn lint && yarn typecheck && yarn test && node scripts/publish-tarballs.mjs && node scripts/tag-packages.mjs"
	},
	"dependencies": {
		"@bedrock-core/catalog": "workspace:*",
		"@bedrock-core/config": "workspace:*",
		"@bedrock-core/guides": "workspace:*"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "3.0.3",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^1.2.0",
		"@minecraft/common": "*",
		"@minecraft/server": "*",
		"@minecraft/server-ui": "*",
		"@minecraft/vanilla-data": "*",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@vitest/coverage-v8": "^4.1.5",
		"eslint": "^10.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2",
		"vitest": "^4.1.5"
	},
	"resolutions": {
		"@bedrock-core/db": "0.1.0",
		"@bedrock-core/flexbox": "1.0.0",
		"@bedrock-core/i18n": "0.2.0",
		"@bedrock-core/navigation": "0.10.0",
		"@bedrock-core/observable": "0.1.0",
		"@bedrock-core/ore-styled": "0.11.0",
		"@bedrock-core/server-runtime": "0.2.0",
		"@bedrock-core/sync": "0.2.0",
		"@bedrock-core/ui-runtime": "0.12.1",
		"@minecraft/common": "1.2.0",
		"@minecraft/server": "2.10.0",
		"@minecraft/server-ui": "2.2.0",
		"@minecraft/vanilla-data": "1.26.50",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
