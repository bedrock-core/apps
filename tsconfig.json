{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowJs": false,
		"checkJs": false,
		"noEmit": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@bedrock-core/ui-runtime",
		"paths": {
			"@bedrock-core/server-runtime": [
				"../server/packages/server-runtime/src/index.ts"
			],
			"@bedrock-core/server-runtime/*": [
				"../server/packages/server-runtime/src/*"
			],
			"@bedrock-core/i18n": [
				"../server/packages/i18n/src/index.ts"
			],
			"@bedrock-core/db": [
				"../server/packages/db/src/index.ts"
			],
			"@bedrock-core/db/minecraft": [
				"../server/packages/db/src/minecraft.ts"
			],
			"@bedrock-core/observable": [
				"../server/packages/observable/src/index.ts"
			],
			"@bedrock-core/observable/minecraft": [
				"../server/packages/observable/src/minecraft.ts"
			],
			"@bedrock-core/sync": [
				"../server/packages/sync/src/index.ts"
			],
			"@bedrock-core/catalog": [
				"./packages/catalog/src/index.ts"
			],
			"@bedrock-core/catalog/*": [
				"./packages/catalog/src/*"
			],
			"@bedrock-core/config": [
				"./packages/config/src/index.ts"
			],
			"@bedrock-core/config/*": [
				"./packages/config/src/*"
			],
			"@bedrock-core/guides": [
				"./packages/guides/src/index.ts"
			],
			"@bedrock-core/guides/*": [
				"./packages/guides/src/*"
			]
		}
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"**/node_modules"
	]
}
