{
	"name": "@bedrock-core/guides",
	"version": "0.3.0",
	"description": "In-game guides with client navigation for @bedrock-core/ui",
	"keywords": [
		"ui",
		"minecraft",
		"bedrock",
		"guides",
		"mdx",
		"docs"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": "github:bedrock-core/apps",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./i18n/*": {
			"types": "./src/i18n/*.ts",
			"import": "./src/i18n/*.ts"
		},
		"./server": {
			"types": "./src/server/index.ts",
			"import": "./src/server/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/__tests__/**",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"tsconfig.json"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@bedrock-core/i18n": "*",
		"@bedrock-core/navigation": "*",
		"@bedrock-core/ore-styled": "*",
		"@bedrock-core/server-runtime": "*",
		"@bedrock-core/ui": "*",
		"@bedrock-core/ui-runtime": "*",
		"@minecraft/common": "*",
		"@minecraft/server": "*",
		"@minecraft/server-ui": "*",
		"@minecraft/vanilla-data": "*",
		"eslint": "*",
		"typescript": "*",
		"vitest": "*"
	},
	"peerDependencies": {
		"@bedrock-core/i18n": "^0.2.0",
		"@bedrock-core/navigation": "^0.13.0",
		"@bedrock-core/ore-styled": "^0.11.1",
		"@bedrock-core/server-runtime": "^0.2.1",
		"@bedrock-core/ui": "^0.13.0",
		"@bedrock-core/ui-runtime": "^0.13.0",
		"@minecraft/server": ">=2.9.0 || >=2.10.0-0"
	},
	"peerDependenciesMeta": {
		"@bedrock-core/i18n": {
			"optional": true
		},
		"@bedrock-core/navigation": {
			"optional": true
		},
		"@bedrock-core/ore-styled": {
			"optional": true
		},
		"@bedrock-core/server-runtime": {
			"optional": true
		},
		"@bedrock-core/ui": {
			"optional": true
		},
		"@bedrock-core/ui-runtime": {
			"optional": true
		}
	},
	"bedrockCore": {
		"i18n": {
			"dir": "./src/i18n",
			"namespace": "core"
		}
	}
}
