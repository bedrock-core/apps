{
	"name": "@bedrock-core/guides",
	"version": "0.1.0",
	"description": "In-game guide screens for @bedrock-core/ui — renders MDX guides compiled by the guides regolith filter",
	"keywords": [
		"ui",
		"minecraft",
		"bedrock",
		"guides",
		"mdx",
		"docs"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": "github:bedrock-core/apps",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./i18n/*": {
			"types": "./src/i18n/*.ts",
			"import": "./src/i18n/*.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"tsconfig.json"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@bedrock-core/i18n": "*",
		"@bedrock-core/ore-styled": "*",
		"@bedrock-core/ui-runtime": "*",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"@bedrock-core/i18n": "*",
		"@bedrock-core/ore-styled": "*",
		"@bedrock-core/ui-runtime": "*"
	},
	"bedrockCore": {
		"i18n": {
			"dir": "./src/i18n",
			"namespace": "core"
		}
	}
}
