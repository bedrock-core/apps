{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@bedrock-core/ui-runtime",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packs/BP/scripts/**/*.ts",
    "packs/BP/scripts/**/*.tsx"
  ]
}
