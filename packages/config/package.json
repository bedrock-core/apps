{
	"name": "@bedrock-core/config",
	"version": "0.2.0",
	"description": "The bedrock-core addon list + config + guide UI: one realm serves it for every registered addon",
	"keywords": [
		"minecraft",
		"bedrock",
		"cross-addon",
		"config",
		"ui",
		"framework"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": "github:bedrock-core/apps",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./i18n/*": {
			"types": "./src/i18n/*.ts",
			"import": "./src/i18n/*.ts"
		},
		"./compiled": {
			"types": "./src/compiled/index.ts",
			"import": "./src/compiled/index.ts"
		},
		"./server": {
			"types": "./src/server/index.ts",
			"import": "./src/server/index.ts"
		}
	},
	"bedrockCore": {
		"i18n": {
			"dir": "./src/i18n",
			"namespace": "core"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/__type-tests__/**",
		"tsconfig.json"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@bedrock-core/db": "*",
		"@bedrock-core/i18n": "*",
		"@bedrock-core/navigation": "*",
		"@bedrock-core/observable": "*",
		"@bedrock-core/ore-styled": "*",
		"@bedrock-core/server-runtime": "*",
		"@bedrock-core/sync": "*",
		"@bedrock-core/ui-runtime": "*",
		"@minecraft/server": "*",
		"typescript": "*",
		"vitest": "*"
	},
	"peerDependencies": {
		"@bedrock-core/db": "*",
		"@bedrock-core/i18n": "*",
		"@bedrock-core/navigation": "*",
		"@bedrock-core/observable": "*",
		"@bedrock-core/ore-styled": "*",
		"@bedrock-core/server-runtime": "*",
		"@bedrock-core/sync": "*",
		"@bedrock-core/ui-runtime": "*",
		"@minecraft/server": ">=2.9.0 || >=2.10.0-0"
	}
}
